generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  SUPERVISOR
  ADMIN
}

model Faculty {
  id        String            @id @default(cuid())
  name      String
  groups    Group[]
  users     User[]
  materials Material[]
  projects  ResearchProject[]
}

model Group {
  id          String       @id @default(cuid())
  name        String
  facultyId   String
  faculty     Faculty      @relation(fields: [facultyId], references: [id])
  teacherId   String?
  teacher     User?        @relation("TeacherGroups", fields: [teacherId], references: [id])
  students    User[]       @relation("StudentGroup")
  assignments Assignment[]

  @@index([facultyId])
}

model User {
  id                 String            @id @default(cuid())
  email              String            @unique
  name               String
  passwordHash       String
  role               Role              @default(STUDENT)
  facultyId          String
  faculty            Faculty           @relation(fields: [facultyId], references: [id])
  groupId            String?
  group              Group?            @relation("StudentGroup", fields: [groupId], references: [id])
  teachingGroups     Group[]           @relation("TeacherGroups")
  sessions           Session[]
  assessments        Assessment[]
  scores             SkillScore[]
  tasks              LearningTask[]
  materials          Material[]
  assignments        Assignment[]
  submissions        Submission[]
  projects           ResearchProject[] @relation("StudentProjects")
  supervisedProjects ResearchProject[] @relation("SupervisorProjects")
  comments           ResearchComment[]
  portfolio          PortfolioItem[]
  messages           ChatMessage[]
  createdAt          DateTime          @default(now())

  @@index([facultyId, groupId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model RateLimit {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model Skill {
  id        String         @id
  name      String
  order     Int
  questions Question[]
  scores    SkillScore[]
  tasks     LearningTask[]
  materials Material[]
}

model Question {
  id           String @id @default(cuid())
  skillId      String
  skill        Skill  @relation(fields: [skillId], references: [id])
  prompt       String
  options      Json
  correctIndex Int
  explanation  String

  @@index([skillId])
}

model Assessment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      String    @default("STARTED")
  questions   Json
  answers     Json?
  results     Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, status])
}

model SkillScore {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill    @relation(fields: [skillId], references: [id])
  percent       Int
  evidenceCount Int
  updatedAt     DateTime @updatedAt

  @@unique([userId, skillId])
}

model LearningTask {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId        String
  skill          Skill     @relation(fields: [skillId], references: [id])
  materialId     String?
  material       Material? @relation(fields: [materialId], references: [id])
  recommendation String
  done           Boolean   @default(false)
  updatedAt      DateTime  @updatedAt

  @@unique([userId, skillId])
}

model Material {
  id             String          @id @default(cuid())
  facultyId      String
  faculty        Faculty         @relation(fields: [facultyId], references: [id])
  skillId        String
  skill          Skill           @relation(fields: [skillId], references: [id])
  authorId       String
  author         User            @relation(fields: [authorId], references: [id])
  title          String
  content        String
  embeddingModel String?
  indexedAt      DateTime?
  createdAt      DateTime        @default(now())
  chunks         MaterialChunk[]
  tasks          LearningTask[]

  @@index([facultyId, skillId])
}

model MaterialChunk {
  id         String                      @id @default(cuid())
  materialId String
  material   Material                    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(768)")?

  @@index([materialId])
}

model Assignment {
  id          String       @id @default(cuid())
  groupId     String
  group       Group        @relation(fields: [groupId], references: [id])
  teacherId   String
  teacher     User         @relation(fields: [teacherId], references: [id])
  title       String
  description String
  dueAt       DateTime?
  createdAt   DateTime     @default(now())
  submissions Submission[]

  @@index([groupId])
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  content      String
  grade        Int?
  feedback     String?
  createdAt    DateTime   @default(now())

  @@unique([userId, assignmentId])
}

model ResearchProject {
  id           String            @id @default(cuid())
  studentId    String
  student      User              @relation("StudentProjects", fields: [studentId], references: [id])
  supervisorId String?
  supervisor   User?             @relation("SupervisorProjects", fields: [supervisorId], references: [id])
  facultyId    String
  faculty      Faculty           @relation(fields: [facultyId], references: [id])
  title        String
  question     String
  method       String
  stage        String            @default("IDEA")
  outcome      String            @default("")
  updatedAt    DateTime          @updatedAt
  createdAt    DateTime          @default(now())
  comments     ResearchComment[]

  @@index([facultyId, supervisorId])
}

model ResearchComment {
  id        String          @id @default(cuid())
  projectId String
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String
  author    User            @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime        @default(now())
}

model PortfolioItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String
  url         String?
  createdAt   DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String
  content   String
  citations Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
